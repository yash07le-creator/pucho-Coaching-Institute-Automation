                      "code": "// @ts-nocheck\nexport const code = async (inputs) => {\n  const raw = inputs.b['lines']; const lines = Array.isArray(raw) ? raw : (typeof raw === 'string' ? (JSON.parse(raw || '[]')) : []);\n  const cols = [\"Session_ID\", \"Date\", \"Batch\", \"Student_ID\", \"Name\", \"Course\", \"Parent_Name\", \"Parent_Phone\", \"Status\", \"Absences_This_Week\", \"Absences_This_Month\", \"Call_Status\", \"Reason\", \"Category\", \"Needs_Followup\", \"Followup_Done\", \"Marked_By\"]; const id = inputs.id; const stamp = Date.now();\n  const rows = lines.map((l, i) => { const r = {}; for (const c of cols) r[c] = l[c] === undefined ? '' : l[c]; r['Session_ID'] = id; r['Att_ID'] = (l['Att_ID'] && !String(l['Att_ID']).startsWith('new-')) ? l['Att_ID'] : 'AT-' + stamp + '-' + String(i + 1).padStart(2, '0'); return r; });\n  return { rows, count: rows.length };\n};",
