            "code": "// @ts-nocheck\nexport const code = async (inputs) => {\n  const C = {\n    \"app_url\": \"{{trigger['body']['app_url']}}\",\n    \"inbound_token\": \"{{trigger['body']['inbound_token']}}\",\n    \"company_name\": \"{{trigger['body']['company_name']}}\",\n    \"flow\": \"ATTENDANCE\",\n    \"brand_tone\": \"formal, precise, courteous\",\n    \"brand_signature\": \"\",\n    \"followup_days\": [\n      2,\n      5,\n      10\n    ],\n    \"quote_validity_days\": 30,\n    \"same_day_quote_hours\": 8,\n    \"default_owner\": \"\",\n    \"own_domain\": \"\",\n    \"quote_series\": \"SMT/Q\",\n    \"catalogue\": [],\n    \"options\": [],\n    \"owners\": []\n  };\n  // v5.1: the app sends app_url, inbound_token and company_name with every call (the step's inputs, from the trigger body)\n  C.app_url = String(inputs.app_url || '').replace(/\\/+$/, ''); C.inbound_token = String(inputs.inbound_token || ''); C.company_name = String(inputs.company_name || '');\n  if (!C.brand_signature) C.brand_signature = 'For ' + C.company_name;\n  C.today = new Date().toISOString(); C.year = new Date().getFullYear();\n  C.catalogue_text = C.catalogue.map(c => c.code + ' = ' + c.name + (c.product_line ? ' (' + c.product_line + ')' : '')).join('; ');\n  C.options_for_model = (C.options || []).filter(o => o.model === ((inputs.body || {}).Model_Code || '')).map(o => o.code + ' = ' + o.description).join('; ');\n  return C;\n};",
