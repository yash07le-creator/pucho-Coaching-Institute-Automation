                  "code": "// @ts-nocheck\nexport const code = async (inputs) => { const p = { ...(inputs.b || {}) }; const JEVP = {}; for (const k of Object.keys(inputs)) if (k.indexOf('jev_') === 0 && k.slice(-11) !== '_confidence') { const f = k.slice(4), v = inputs[k], conf = Number(inputs[k + '_confidence']); const pol = JEVP[f] || [0.5, null]; if (v !== undefined && v !== '' && (isNaN(conf) || conf >= pol[0])) p[f] = v; else if (pol[1] !== null && pol[1] !== undefined) p[f] = pol[1]; } /* a Jev answer lands only when confident; else the fallback */ const now = new Date().toISOString(); const allowed = [\"Session_ID\", \"Date\", \"Batch\", \"Total_Count\", \"Present_Count\", \"Absent_Count\", \"Absentees\", \"Marked_By\", \"Saved_At\"]; const map = {}; const fill = {\"Saved_At\": \"now\"};\n  const src = { ...p }; for (const [k, c] of Object.entries(map)) if (p[k] !== undefined) src[c] = p[k];\n  const row = {}; for (const k of allowed) row[k] = src[k] === undefined ? '' : src[k]; for (const [k, v] of Object.entries(fill)) row[k] = v === 'now' ? now : v;\n  if (!row['Saved_At']) row['Saved_At'] = now;\n  return { row };\n};",
