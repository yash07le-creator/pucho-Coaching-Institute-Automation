{
  "flow": "ATTENDANCE",
  "covers": [
    "R14",
    "R15"
  ],
  "connections": "portable",
  "fire_and_forget": false,
  "allow_pieces": [
    "http",
    "webhook"
  ],
  "allow_names": [
    "catch_webhook",
    "return_response",
    "send_request"
  ],
  "require_capabilities": [
    "receive_ATTENDANCE=trigger:webhook:trigger",
    "step_save_batch_insert=step_save_batch_insert:http:write",
    "step_save_batch_insert_lines=step_save_batch_insert_lines:http:write",
    "step_save_batch_notify_post=step_save_batch_notify_post:http:write",
    "step_save_batch_done=step_save_batch_done:webhook:respond"
  ],
  "unverified_outputs": []
}