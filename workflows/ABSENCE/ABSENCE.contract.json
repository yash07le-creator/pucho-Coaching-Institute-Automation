{
  "flow": "ABSENCE",
  "covers": [
    "R14",
    "R15",
    "R16",
    "R17"
  ],
  "connections": "portable",
  "fire_and_forget": false,
  "allow_pieces": [
    "http",
    "pucho-whatsapp",
    "webhook"
  ],
  "allow_names": [
    "catch_webhook",
    "return_response",
    "send_request",
    "send_template_message"
  ],
  "require_capabilities": [
    "receive_ABSENCE=trigger:webhook:trigger",
    "step_absent_team=step_absent_team:http:read",
    "step_absent_send=step_absent_send:pucho-whatsapp:write",
    "step_absent_update=step_absent_update:http:write",
    "step_absent_log=step_absent_log:http:write",
    "step_absent_alert=step_absent_alert:http:write",
    "step_absent_staff_send=step_absent_staff_send:pucho-whatsapp:write",
    "step_absent_staff_log=step_absent_staff_log:http:write",
    "step_absent_done=step_absent_done:webhook:respond"
  ],
  "unverified_outputs": [
    "pucho-whatsapp:send_template_message (response shape, rules §1.20 #5)"
  ]
}