{
  "flow": "SEND_WHATSAPP",
  "covers": [
    "R34"
  ],
  "connections": "portable",
  "fire_and_forget": false,
  "allow_pieces": [
    "http",
    "pucho-whatsapp",
    "webhook"
  ],
  "allow_names": [
    "catch_webhook",
    "return_response",
    "send_request",
    "send_template_message"
  ],
  "require_capabilities": [
    "receive_SEND_WHATSAPP=trigger:webhook:trigger",
    "step_send_update_send=step_send_update_send:pucho-whatsapp:write",
    "step_send_update_log=step_send_update_log:http:write",
    "step_send_update_done=step_send_update_done:webhook:respond",
    "step_unknown_action=step_unknown_action:webhook:respond"
  ],
  "unverified_outputs": [
    "pucho-whatsapp:send_template_message (response shape, rules §1.20 #5)"
  ]
}