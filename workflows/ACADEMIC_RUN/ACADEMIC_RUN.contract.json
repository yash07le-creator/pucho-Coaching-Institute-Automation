{
  "flow": "ACADEMIC_RUN",
  "covers": [
    "R20"
  ],
  "connections": "portable",
  "fire_and_forget": false,
  "allow_pieces": [
    "http",
    "schedule",
    "webhook"
  ],
  "allow_names": [
    "cron_expression",
    "return_response",
    "send_request"
  ],
  "require_capabilities": [
    "receive_ACADEMIC_RUN=trigger:schedule:trigger",
    "step_run_students=step_run_students:http:read",
    "step_run_post_post=step_run_post_post:http:write",
    "step_run_done=step_run_done:webhook:respond"
  ],
  "unverified_outputs": []
}