{
  "flow": "FEE_RUN",
  "covers": [
    "R24",
    "R27"
  ],
  "connections": "portable",
  "fire_and_forget": false,
  "allow_pieces": [
    "http",
    "schedule",
    "webhook"
  ],
  "allow_names": [
    "cron_expression",
    "return_response",
    "send_request"
  ],
  "require_capabilities": [
    "receive_FEE_RUN=trigger:schedule:trigger",
    "step_run_fees=step_run_fees:http:read",
    "step_run_team=step_run_team:http:read",
    "step_run_patch_update=step_run_patch_update:http:write",
    "step_run_post_post=step_run_post_post:http:write",
    "step_run_done=step_run_done:webhook:respond"
  ],
  "unverified_outputs": []
}