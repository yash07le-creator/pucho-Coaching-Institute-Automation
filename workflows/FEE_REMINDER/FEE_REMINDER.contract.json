{
  "flow": "FEE_REMINDER",
  "covers": [
    "R24",
    "R25",
    "R27"
  ],
  "connections": "portable",
  "fire_and_forget": false,
  "allow_pieces": [
    "ai-voice-call",
    "delay",
    "http",
    "pucho-cdm",
    "pucho-whatsapp",
    "webhook"
  ],
  "allow_names": [
