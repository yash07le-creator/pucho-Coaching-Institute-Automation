{
  "flow": "STUDENT_MANAGE",
  "covers": [
    "R10",
    "R11"
  ],
  "connections": "portable",
  "fire_and_forget": false,
  "allow_pieces": [
    "http",
    "pucho-whatsapp",
    "webhook"
  ],
  "allow_names": [
    "catch_webhook",
    "return_response",
    "send_request",
    "send_template_message"
  ],
  "require_capabilities": [
    "receive_STUDENT_MANAGE=trigger:webhook:trigger",
    "step_enrol_insert=step_enrol_insert:http:write",
    "step_enrol_send=step_enrol_send:pucho-whatsapp:write",
    "step_enrol_fee=step_enrol_fee:http:write",
    "step_enrol_log=step_enrol_log:http:write",
    "step_enrol_lead_update=step_enrol_lead_update:http:write",
    "step_enrol_done=step_enrol_done:webhook:respond",
    "step_unknown_action=step_unknown_action:webhook:respond"
  ],
  "unverified_outputs": [
    "pucho-whatsapp:send_template_message (response shape, rules §1.20 #5)"
  ]
}