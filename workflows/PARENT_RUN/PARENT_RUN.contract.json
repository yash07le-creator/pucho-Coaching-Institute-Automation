{
  "flow": "PARENT_RUN",
  "covers": [
    "R29",
    "R30",
    "R33"
  ],
  "connections": "portable",
  "fire_and_forget": false,
  "allow_pieces": [
    "http",
    "schedule",
    "webhook"
  ],
  "allow_names": [
    "cron_expression",
    "return_response",
    "send_request"
  ],
  "require_capabilities": [
    "receive_PARENT_RUN=trigger:schedule:trigger",
    "step_run_students=step_run_students:http:read",
    "step_run_calls=step_run_calls:http:read",
    "step_run_reports_post=step_run_reports_post:http:write",
    "step_run_calls_post_post=step_run_calls_post_post:http:write",
    "step_run_retried_update=step_run_retried_update:http:write",
    "step_run_done=step_run_done:webhook:respond"
  ],
  "unverified_outputs": []
}